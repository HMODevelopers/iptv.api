# HMODevelopers IPTV API
# APPLICATION
NODE_ENV=development
APP_NAME=HMODevelopers IPTV API
APP_HOST=0.0.0.0
PORT=3000
API_PREFIX=api
API_VERSION=1
LOG_LEVEL=log
# DATABASE - MARIADB
DB_TYPE=mariadb
DB_HOST=192.168.1.12
DB_PORT=3306
DB_USERNAME=COLOCAR_USUARIO
DB_PASSWORD=COLOCAR_PASSWORD
DB_DATABASE=hmodevelopers_iptv
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_CONNECTION_LIMIT=10
# TYPEORM
TYPEORM_MIGRATIONS_RUN=false
# IPTV-ORG
IPTV_ORG_API_URL=https://iptv-org.github.io/api
IPTV_ORG_REQUEST_TIMEOUT_MS=15000
IPTV_ORG_MAX_RETRIES=3
IPTV_SYNC_BATCH_SIZE=250
# CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
# SWAGGER
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
# SECURITY
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
# DOCKER
DOCKER_HOST_PORT=3003
DOCKER_DB_NETWORK=COLOCAR_RED_DOCKER

# Fase 2: completar secretos diferentes y aleatorios; no usar estos marcadores.
JWT_ACCESS_SECRET=COLOCAR_SECRETO_ALEATORIO_ACCESS_48_CARACTERES_MINIMO
JWT_REFRESH_SECRET=COLOCAR_SECRETO_ALEATORIO_REFRESH_48_CARACTERES_MINIMO
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_SECONDS=900
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_MS=60000
AUTH_MAX_SESSIONS=10
